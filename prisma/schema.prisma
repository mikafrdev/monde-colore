generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

enum Role {
  ADMIN // ancien "admin"
  STAFF // ancien "staff" — à décider si tu gardes
  MEMBER // nouveau — remplace "user" pour les membres famille
  GUEST // nouveau — visiteur avec compte
  PUBLIC // nouveau — anonyme
}

model User {
  id            String    @id
  role          Role      @default(GUEST)
  section       String? // "caro", "leo", "mika", "denise"...
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  author Author?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────
// Privilèges
// ─────────────────────────────────────────

model CategoryPermission {
  id           String         @id @default(cuid())
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  roleOrUserId String // peut être un Role enum OU un User.id
  type         PermissionType @default(ROLE)
  granted      Boolean        @default(true) // true = accès, false = refus explicite

  @@unique([categoryId, roleOrUserId])
}

enum PermissionType {
  ROLE // s'applique à tous les users avec ce rôle
  USER // s'applique à un user spécifique
}

enum Visibility {
  PUBLIC // tout le monde
  FAMILY // tous les MEMBER + ADMIN connectés
  PRIVATE // ADMIN uniquement
}

// ─────────────────────────────────────────
// TABLES
// ─────────────────────────────────────────

model Author {
  id          String                  @id @default(cuid())
  name        String
  bio         String?
  avatarUrl   String?
  userId      String?                 @unique
  user        User?                   @relation(fields: [userId], references: [id])
  articles    Article[]
  collections CollectionContributor[]
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  parentRelations CategoryRelation[] @relation("ParentCategory")
  childRelations  CategoryRelation[] @relation("ChildCategory")

  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  isPublic    Boolean              @default(true)
  permissions CategoryPermission[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  ARTICLE
  INFORMATION
  CUISINE
  JEUXVIDEO
  LEO
  CARO
  MIKA
  MAMAN
  SITES
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String        @unique
  excerpt     String?
  body        String        @default("[]")
  content     Content?
  status      ArticleStatus @default(DRAFT)
  type        ArticleType   @default(ARTICLE)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  visibility Visibility @default(PUBLIC)

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id])

  categories     Category[]
  tags           ArticleTag[]
  contents       ArticleContent[]
  views          ArticleView[]
  images         ArticleImage[]
  videos         ArticleVideo[]
  timelineEvents TimelineEvent[]
}

model ArticleContent {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order     Int?
  label     String? // "Document associé", "Voir aussi"...

  @@unique([articleId, contentId])
  @@index([articleId])
}

enum ImageType {
  ARTICLE
  GALLERY
  AVATAR
  COVER
}

model Image {
  id        String    @id @default(cuid())
  url       String    @unique
  alt       String?
  type      ImageType @default(ARTICLE)
  filename  String?
  width     Int?
  height    Int?
  size      Int?
  mimeType  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  section    String? // "caro", "leo", "mika", "general"
  visibility Visibility @default(PUBLIC)

  articles       ArticleImage[]
  timelineEvents TimelineEvent[]
  collections    Collection[]    @relation("CollectionCover") // ← nom explicite
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  UPLOAD
  OTHER
}

enum VideoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Video {
  id          String  @id @default(cuid())
  title       String
  description String?
  embedUrl    String? // YouTube, Vimeo
  fileUrl     String? // fichier uploadé

  provider VideoProvider
  status   VideoStatus   @default(DRAFT)

  // Métadonnées fichier (upload uniquement)
  filename String?
  size     Int? // en octets
  mimeType String? // ex. video/mp4
  width    Int?
  height   Int?

  // Lecture & affichage
  duration     Int? // en secondes
  thumbnailUrl String?
  altText      String? // accessibilité

  // Publication
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section    String? // "caro", "leo", "mika", "general"
  visibility Visibility @default(PUBLIC)

  content  Content?
  articles ArticleVideo[]
}

model Document {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String   @unique
  mimeType  String // "application/pdf"
  size      Int? // en octets
  createdAt DateTime @default(now())

  content Content?
}

model Timeline {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility Visibility @default(PUBLIC)

  events  TimelineEvent[]
  content Content?
}

model TimelineEvent {
  id          String   @id @default(cuid())
  timelineId  String
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  description String?
  order       Int
  imageId     String?
  image       Image?   @relation(fields: [imageId], references: [id])
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id])

  @@index([timelineId, order])
}

enum SourceType {
  PERSON
  COLLECTIVE
  BRAND
  MEDIA
  POLITICAL
  INSTITUTION
  COMPANY
}

model Source {
  id          String             @id @default(cuid())
  name        String
  logo        String?
  type        SourceType
  bio         String?
  medias      Media[]
  articles    Article[]
  collections CollectionSource[]
}

enum MediaType {
  YOUTUBE
  TWITTER
  ODYSSEE
  WEBSITE
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  RSS
  PODCAST
  IMAGE
  VIDEO
  AUDIO
  PDF
  GITHUB
  PORTFOLIO
  OTHER
}

model Media {
  id      String    @id @default(cuid())
  url     String    @unique
  type    MediaType
  sources Source[]
}

// ─────────────────────────────────────────
// COLLECTION
// ─────────────────────────────────────────

enum CollectionType {
  DOSSIER
  SERIE
  ENQUETE
  LIVE
  SPECIAL
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  LIVE
}

enum CollectionContributorRole {
  EDITOR
  WRITER
  RESEARCHER
  PHOTOGRAPHER
}

enum CollectionSourceRole {
  PRIMARY
  CONTRIBUTOR
  CITED
}

model Collection {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  type         CollectionType
  status       CollectionStatus @default(DRAFT)
  coverImageId String?
  coverImage   Image?           @relation("CollectionCover", fields: [coverImageId], references: [id])

  startedAt DateTime? // utile pour ENQUETE, LIVE
  endedAt   DateTime? // null = en cours
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  visibility Visibility @default(PUBLIC)

  items        CollectionItem[]
  sources      CollectionSource[]
  contributors CollectionContributor[]
  content      Content?
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentId    String
  content      Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order        Int
  isPrimary    Boolean    @default(false)
  label        String? // "Épisode 1", "Document clé"...

  @@unique([collectionId, contentId])
  @@index([collectionId, order])
}

model CollectionSource {
  id           String               @id @default(cuid())
  collectionId String
  collection   Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceId     String
  source       Source               @relation(fields: [sourceId], references: [id])
  role         CollectionSourceRole @default(PRIMARY)

  @@unique([collectionId, sourceId])
}

model CollectionContributor {
  id           String                    @id @default(cuid())
  collectionId String
  collection   Collection                @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  authorId     String
  author       Author                    @relation(fields: [authorId], references: [id])
  role         CollectionContributorRole @default(WRITER)

  @@unique([collectionId, authorId])
}

// ─────────────────────────────────────────
// CONTENT
// ─────────────────────────────────────────

enum ContentType {
  ARTICLE
  VIDEO
  DOCUMENT
  TIMELINE
  COLLECTION
}

model Content {
  id        String      @id @default(cuid())
  type      ContentType
  createdAt DateTime    @default(now())

  // Un seul renseigné à la fois — contrainte applicative
  articleId    String?     @unique
  article      Article?    @relation(fields: [articleId], references: [id])
  videoId      String?     @unique
  video        Video?      @relation(fields: [videoId], references: [id])
  documentId   String?     @unique
  document     Document?   @relation(fields: [documentId], references: [id])
  timelineId   String?     @unique
  timeline     Timeline?   @relation(fields: [timelineId], references: [id])
  collectionId String?     @unique
  collection   Collection? @relation(fields: [collectionId], references: [id])

  collectionItems CollectionItem[]
  articleContents ArticleContent[]
}

// ─────────────────────────────────────────
// JOINTURES
// ─────────────────────────────────────────

model CategoryRelation {
  parentId String
  childId  String
  parent   Category @relation("ParentCategory", fields: [parentId], references: [id], onDelete: Cascade)
  child    Category @relation("ChildCategory", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@unique([parentId, childId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleImage {
  articleId String
  imageId   String
  order     Int?
  isPrimary Boolean @default(false) // true = image de couverture

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([articleId, imageId])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  ipHash    String?
  viewedAt  DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleVideo {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  caption   String? // légende spécifique à cet article
  isPrimary Boolean @default(false)

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([articleId, videoId])
  @@index([articleId, order])
}

// Si tu n'as pas encore ce enum (à vérifier avec ArticleImage)
enum MediaRole {
  COVER // hero / couverture
  INLINE // dans le corps de l'article
  GALLERY // galerie en bas
}
