generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

enum Role {
  ADMIN // ancien "admin"
  STAFF // ancien "staff" — à décider si tu gardes
  MEMBER // nouveau — remplace "user" pour les membres famille
  GUEST // nouveau — visiteur avec compte
  PUBLIC // nouveau — anonyme
}

enum Site {
  CARO
  LEO
  MIKA
  MAMAN
  GENERAL
}

model User {
  id            String    @id
  role          Role      @default(GUEST)
  site          Site?
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  author              Author?
  categoryPermissions CategoryPermission[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────
// Privilèges
// ─────────────────────────────────────────

model CategoryPermission {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  role       Role?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  granted    Boolean  @default(true)

  @@unique([categoryId, role])
  @@unique([categoryId, userId])
}

enum PermissionType {
  ROLE // s'applique à tous les users avec ce rôle
  USER // s'applique à un user spécifique
}

enum Visibility {
  PUBLIC // tout le monde
  FAMILY // tous les MEMBER + ADMIN connectés
  PRIVATE // ADMIN uniquement
}

// ─────────────────────────────────────────
// TABLES
// ─────────────────────────────────────────

model Author {
  id          String                  @id @default(cuid())
  name        String
  bio         String?
  avatarUrl   String?
  userId      String?                 @unique
  user        User?                   @relation(fields: [userId], references: [id])
  articles    Article[]
  collections CollectionContributor[]
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?

  imageId String? @unique

  image Image? @relation("CategoryImage", fields: [imageId], references: [id])

  parentRelations CategoryRelation[] @relation("ParentCategory")
  childRelations  CategoryRelation[] @relation("ChildCategory")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  articles  Article[]
  sites CategorySite[]
  
  isPublic    Boolean              @default(true)
  permissions CategoryPermission[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String
  slug     String       @unique
  articles ArticleTag[]
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  excerpt     String?
  body        Json?
  content     Content?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  visibility Visibility @default(PUBLIC)

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id])

  categories     Category[]
  tags           ArticleTag[]
  contents       ArticleContent[]
  views          ArticleView[]
  images         ArticleImage[]
  videos         ArticleVideo[]
  timelineEvents TimelineEvent[]
  sites          ArticleSite[]
  game           Game?            @relation(fields: [gameId], references: [id])
  gameId         String?

  @@index([authorId])
  @@index([sourceId])
  @@index([gameId])
  @@index([status, publishedAt])
}

model ArticleContent {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order     Int?
  label     String? // "Document associé", "Voir aussi"...

  @@unique([articleId, contentId])
  @@index([articleId])
}

enum ImageType {
  ARTICLE
  GALLERY
  AVATAR
  COVER
}

model Image {
  id        String    @id @default(cuid())
  url       String    @unique
  alt       String?
  type      ImageType @default(ARTICLE)
  filename  String?
  width     Int?
  height    Int?
  size      Int?
  mimeType  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  visibility Visibility @default(PUBLIC)

  articles       ArticleImage[]
  timelineEvents TimelineEvent[]
  sites          ArticleSite[]
  collections    Collection[]    @relation("CollectionCover") // ← nom explicite
  categories     Category[]      @relation("CategoryImage")
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  UPLOAD
  OTHER
}

model Video {
  id          String  @id @default(cuid())
  title       String
  description String?
  embedUrl    String? // YouTube, Vimeo
  fileUrl     String? // fichier uploadé

  provider VideoProvider
  status   PublicationStatus @default(DRAFT)

  // Métadonnées fichier (upload uniquement)
  filename String?
  size     Int? // en octets
  mimeType String? // ex. video/mp4
  width    Int?
  height   Int?

  // Lecture & affichage
  duration     Int? // en secondes
  thumbnailUrl String?
  altText      String? // accessibilité

  // Publication
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visibility Visibility @default(PUBLIC)

  content  Content?
  articles ArticleVideo[]
  sites    ArticleSite[]
}

model Document {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String   @unique
  mimeType  String // "application/pdf"
  size      Int? // en octets
  createdAt DateTime @default(now())

  content Content?
}

model Timeline {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visibility Visibility @default(PUBLIC)

  events  TimelineEvent[]
  content Content?
}

model TimelineEvent {
  id          String   @id @default(cuid())
  timelineId  String
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  description String?
  order       Int
  imageId     String?
  image       Image?   @relation(fields: [imageId], references: [id])
  articleId   String?
  article     Article? @relation(fields: [articleId], references: [id])

  @@index([timelineId, order])
}

enum SourceType {
  PERSON
  COLLECTIVE
  BRAND
  MEDIA
  POLITICAL
  INSTITUTION
  COMPANY
}

model Source {
  id          String             @id @default(cuid())
  name        String
  logo        String?
  type        SourceType
  bio         String?
  medias      Media[]
  articles    Article[]
  collections CollectionSource[]
}

enum MediaType {
  YOUTUBE
  TWITTER
  ODYSSEE
  WEBSITE
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  RSS
  PODCAST
  IMAGE
  VIDEO
  AUDIO
  PDF
  GITHUB
  PORTFOLIO
  OTHER
}

model Media {
  id      String    @id @default(cuid())
  url     String    @unique
  type    MediaType
  sources Source[]
}

//-------------- FIN ARTICLES / CONTENU -----------------

enum PlatformType {
  CONSOLE
  HANDHELD
  MOBILE
  COMPUTER
  ARCADE
  CLOUD
  WEB
}

model Platform {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  type PlatformType

  games          GamePlatform[]
  console        Console[]
  gameEditions   GameEdition[]
  platformMedias PlatformMedia[]
}

model PlatformMedia {
  platformId String
  platform   Platform @relation(fields: [platformId], references: [id])

  mediaType GameMediaType

  notes String?

  @@id([platformId, mediaType])
}

model GamePlatform {
  isExclusive  Boolean @default(false)
  regionLocked Boolean @default(false)
  notes        String?

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  platformId String
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  mediaType GameMediaType?

  releasedAt DateTime?

  @@id([gameId, platformId])
}

enum GameKind {
  MAIN
  SPIN_OFF
  REMAKE
  REMASTER
  COLLECTION
  EXPANSION
  DLC
}

model Game {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  kind GameKind @default(MAIN)

  releaseDate DateTime?
  coverUrl    String?

  publisherId String?
  publisher   Company? @relation("Publisher", fields: [publisherId], references: [id])

  developerId String?
  developer   Company? @relation("Developer", fields: [developerId], references: [id])

  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])

  gameCollection   GameCollection? @relation(fields: [gameCollectionId], references: [id])
  gameCollectionId String?

  gameEditions GameEdition[]
  articles     Article[]
  platforms    GamePlatform[]
  gameGenres   GameGenre[]

  @@index([publisherId])
  @@index([developerId])
  @@index([franchiseId])
  @@index([gameCollectionId])
}

model GameEdition {
  id String @id @default(cuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  platformId String?
  platform   Platform? @relation(fields: [platformId], references: [id])

  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  title    String?
  coverUrl String?
  barcode  String?

  releasedAt DateTime?

  @@unique([gameId, platformId, regionId])
}

model GameCollection {
  id String @id @default(cuid())

  name String //Pokemon Generation 1: - Rouge - Bleu - Jaune

  games Game[]
}

model Franchise {
  id String @id @default(cuid())

  name String @unique //Final Fantasy Pokemon Resident Evil
  slug String @unique

  description String?

  games Game[]
}

model Genre {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  games GameGenre[]
}

model GameGenre {
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
}

model Console {
  id   String @id @default(cuid())
  name String @unique // "Nintendo Switch"
  slug String @unique

  shortName   String?
  releaseYear Int?

  platformId String
  platform   Platform @relation(fields: [platformId], references: [id])

  manufacturerId String
  manufacturer   Company @relation(fields: [manufacturerId], references: [id])

  types       ConsoleCategory[]
  media       ConsoleMedia[]
  accessories ConsoleAccessory[]
  setups      ConsoleConfiguration[]

  compatibleAccessories Accessory[]      @relation("AccessoryCompatibility")
  consoleVariants       ConsoleVariant[]

  @@index([manufacturerId])
}

model ConsoleCategory {
  id String @id @default(cuid())

  name String @unique //HOME HANDHELD HYBRID MICRO PLUG_AND_PLAY
  slug String @unique

  consoles Console[]
}

enum GameMediaType {
  CARTRIDGE
  DISC
  DIGITAL
  FLOPPY
  TAPE
}

model ConsoleMedia {
  consoleId String
  console   Console @relation(fields: [consoleId], references: [id])

  mediaType GameMediaType

  notes String?

  @@id([consoleId, mediaType])
}

model ConsoleAccessory {
  id String @id @default(cuid())

  releasedAt DateTime?

  consoleId String
  console   Console @relation(fields: [consoleId], references: [id])

  accessoryId String
  accessory   Accessory @relation(fields: [accessoryId], references: [id])

  required Boolean @default(false)

  @@unique([consoleId, accessoryId])
}

model ConsoleConfiguration {
  id String @id @default(cuid())

  name String

  baseConsoleId String
  baseConsole   Console @relation(fields: [baseConsoleId], references: [id])

  accessories ConsoleConfigurationAccessory[]

  mediaTypes GameMediaType[]
}

model ConsoleConfigurationAccessory {
  setupId String
  setup   ConsoleConfiguration @relation(fields: [setupId], references: [id])

  accessoryId String
  accessory   Accessory @relation(fields: [accessoryId], references: [id])

  required Boolean @default(true)

  @@id([setupId, accessoryId])
}

model ConsoleVariant {
  id String @id @default(cuid())

  name String

  consoleId String
  console   Console @relation(fields: [consoleId], references: [id])

  releaseYear Int?

  notes String?
}

model Region {
  id String @id @default(cuid())

  code String @unique
  name String

  releases GameEdition[]
}

model Company {
  id   String @id @default(cuid())
  name String @unique // "Nintendo", "Capcom", "Sony"
  slug String @unique

  logoUrl     String?
  country     String?
  description String?

  manufacturedConsoles    Console[]
  manufacturedAccessories Accessory[]

  publishedGames Game[] @relation("Publisher")
  developedGames Game[] @relation("Developer")

  @@index([name])
}

enum AccessoryType {
  CONTROLLER
  CAMERA
  MEMORY_CARD
  CABLE
  ADAPTER
  KEYBOARD
  MOUSE
  HEADSET
  LIGHT_GUN
  STORAGE
  OTHER
}

model Accessory {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?
  imageUrl    String?
  releaseYear Int?

  type AccessoryType @default(OTHER)

  manufacturerId String
  manufacturer   Company @relation(fields: [manufacturerId], references: [id])

  consoleAccessories ConsoleAccessory[]

  setupAccessories ConsoleConfigurationAccessory[]

  compatibleConsoles Console[] @relation("AccessoryCompatibility")
}

// ─────────────────────────────────────────
// COLLECTION
// ─────────────────────────────────────────

enum CollectionType {
  DOSSIER
  SERIE
  ENQUETE
  LIVE
  SPECIAL
  GUIDE
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  LIVE
}

enum CollectionContributorRole {
  EDITOR
  WRITER
  RESEARCHER
  PHOTOGRAPHER
}

enum CollectionSourceRole {
  PRIMARY
  CONTRIBUTOR
  CITED
}

model Collection {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  type         CollectionType
  status       CollectionStatus @default(DRAFT)
  coverImageId String?
  coverImage   Image?           @relation("CollectionCover", fields: [coverImageId], references: [id])

  startedAt DateTime? // utile pour ENQUETE, LIVE
  endedAt   DateTime? // null = en cours
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  visibility Visibility @default(PUBLIC)

  items        CollectionItem[]
  sources      CollectionSource[]
  contributors CollectionContributor[]
  content      Content?
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentId    String
  content      Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  order        Int
  isPrimary    Boolean    @default(false)
  label        String? // "Épisode 1", "Document clé"...

  @@unique([collectionId, contentId])
  @@index([collectionId, order])
}

model CollectionSource {
  id           String               @id @default(cuid())
  collectionId String
  collection   Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceId     String
  source       Source               @relation(fields: [sourceId], references: [id])
  role         CollectionSourceRole @default(PRIMARY)

  @@unique([collectionId, sourceId])
}

model CollectionContributor {
  id           String                    @id @default(cuid())
  collectionId String
  collection   Collection                @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  authorId     String
  author       Author                    @relation(fields: [authorId], references: [id])
  role         CollectionContributorRole @default(WRITER)

  @@unique([collectionId, authorId])
}

// ─────────────────────────────────────────
// CONTENT
// ─────────────────────────────────────────

enum ContentType {
  ARTICLE
  VIDEO
  DOCUMENT
  TIMELINE
  COLLECTION
}

model Content {
  id        String      @id @default(cuid())
  type      ContentType
  createdAt DateTime    @default(now())

  // Un seul renseigné à la fois — contrainte applicative
  articleId    String?     @unique
  article      Article?    @relation(fields: [articleId], references: [id])
  videoId      String?     @unique
  video        Video?      @relation(fields: [videoId], references: [id])
  documentId   String?     @unique
  document     Document?   @relation(fields: [documentId], references: [id])
  timelineId   String?     @unique
  timeline     Timeline?   @relation(fields: [timelineId], references: [id])
  collectionId String?     @unique
  collection   Collection? @relation(fields: [collectionId], references: [id])

  collectionItems CollectionItem[]
  articleContents ArticleContent[]
}

// ─────────────────────────────────────────
// JOINTURES
// ─────────────────────────────────────────

model CategoryRelation {
  parentId String
  childId  String
  parent   Category @relation("ParentCategory", fields: [parentId], references: [id], onDelete: Cascade)
  child    Category @relation("ChildCategory", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleImage {
  articleId String
  imageId   String
  order     Int?
  isPrimary Boolean @default(false) // true = image de couverture

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([articleId, imageId])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  ipHash    String?
  viewedAt  DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleVideo {
  id        String  @id @default(cuid())
  order     Int     @default(0)
  caption   String? // légende spécifique à cet article
  isPrimary Boolean @default(false)

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([articleId, videoId])
  @@index([articleId, order])
}

model ArticleSite {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  site      Site

  featured Boolean @default(false) // mis en avant sur la home de CE site
  pinned   Boolean @default(false) // épinglé en haut, indépendamment du tri par date
  order    Int? // ordre manuel d'affichage sur ce site

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     Image?   @relation(fields: [imageId], references: [id])
  imageId   String?
  video     Video?   @relation(fields: [videoId], references: [id])
  videoId   String?

  @@unique([articleId, site])
  @@index([site, featured])
  @@index([site, order])
}

model CategorySite {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  site       Site

  featured Boolean @default(false) // mise en avant sur ce site
  order    Int?    // ordre d'affichage (ex: dans un menu de navigation)
  visible  Boolean @default(true)  // afficher/masquer indépendamment des articles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, site])
  @@index([site, featured])
  @@index([site, order])
}

